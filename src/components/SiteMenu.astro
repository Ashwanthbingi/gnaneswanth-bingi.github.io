---
/**
 * Mobile navigation
 *
 * Below the `tablet` breakpoint the header's inline nav is hidden, so this
 * supplies the only way to move between sections on touch devices. It lives
 * outside `.site-wrapper` on purpose: the wrapper carries a `clip-path`, which
 * would visually clip any fixed-position descendant.
 */
import { withBase } from '../utils/paths'

const menu = [
  { id: 'about', text: 'About' },
  { id: 'work', text: 'Work' },
  { id: 'projects', text: 'Projects' },
  { id: 'contact', text: 'Contact' },
]
---

<div class="site-menu js-site-menu">
  <button
    class="site-menu__toggle js-menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-menu-panel"
    aria-label="Open menu"
  >
    <span class="site-menu__bars" aria-hidden="true">
      <span class="site-menu__bar"></span>
      <span class="site-menu__bar"></span>
    </span>
  </button><!-- .site-menu__toggle -->

  <nav
    class="site-menu__panel js-menu-panel"
    id="site-menu-panel"
    aria-label="Main"
    aria-hidden="true"
  >
    <ul class="site-menu__list">
      {
        menu.map((item, index) => (
          <li class="site-menu__item" style={`--i: ${index}`}>
            <a href={'#' + item.id} class="js-menu-panel-link" data-id={item.id}>
              <span class="site-menu__index">
                0{index + 1}
              </span>
              <span class="site-menu__label">{item.text}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="site-menu__foot" style={`--i: ${menu.length}`}>
      <a href={withBase('resume.pdf')} class="c-btn site-menu__cta" download>
        <span class="c-btn__label"><span class="sup">↓</span> Résumé</span>
      </a>

      <a href="mailto:aswanthbingi@gmail.com" class="site-menu__mail">
        aswanthbingi@gmail.com
      </a>
    </div><!-- .site-menu__foot -->
  </nav><!-- .site-menu__panel -->
</div><!-- .site-menu -->

<script>
  import Emitter from '../utils/Emitter'

  const FOCUSABLE =
    'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'

  class Menu {
    el: HTMLElement
    toggle: HTMLButtonElement
    panel: HTMLElement
    links: NodeListOf<HTMLAnchorElement>

    isOpen: boolean = false
    lastFocused: HTMLElement | null = null
    /**
     * Constructor
     */
    constructor() {
      this.el = document.querySelector('.js-site-menu')

      if (!this.el) return

      this.toggle = this.el.querySelector<HTMLButtonElement>('.js-menu-toggle')
      this.panel = this.el.querySelector<HTMLElement>('.js-menu-panel')
      this.links = this.panel.querySelectorAll<HTMLAnchorElement>(
        '.js-menu-panel-link'
      )

      this.close(false)

      this.bindEvents()
    }

    /**
     * Bind events
     */
    bindEvents() {
      this.toggle.addEventListener('click', () => {
        this.isOpen ? this.close() : this.open()
      })

      this.links.forEach((link) => {
        link.addEventListener('click', this.onLinkClick.bind(this))
      })

      document.addEventListener('keydown', this.onKeyDown.bind(this))

      // Keep the panel in step with the desktop nav's active section.
      Emitter.on('sectionchange', this.onSectionChange, this)

      /*
       * Rotating to a width where the inline header nav takes over would leave
       * the panel open behind it, so close on any width change.
       */
      Emitter.on('resize', this.onResize, this)
    }

    /**
     * Resize handler
     */
    onResize(widthChanged: boolean) {
      if (widthChanged && this.isOpen) this.close(false)
    }

    /**
     * Section change handler
     */
    onSectionChange(id: string) {
      this.links.forEach((link) => {
        link.parentElement.classList.toggle('is-active', link.dataset.id === id)
      })
    }

    /**
     * Open
     */
    open() {
      this.isOpen = true
      this.lastFocused = document.activeElement as HTMLElement

      this.el.classList.add('is-open')
      document.documentElement.classList.add('is-menu-open')

      this.panel.removeAttribute('aria-hidden')
      this.panel.removeAttribute('inert')

      this.toggle.setAttribute('aria-expanded', 'true')
      this.toggle.setAttribute('aria-label', 'Close menu')

      window.lenis?.stop?.()

      // Wait a frame so the panel is focusable before moving focus into it.
      requestAnimationFrame(() => {
        this.links[0]?.focus()
      })
    }

    /**
     * Close
     *
     * `restoreFocus` is false for the initial setup pass and for width changes,
     * where stealing focus back to the toggle would be unexpected.
     */
    close(restoreFocus = true) {
      this.isOpen = false

      this.el.classList.remove('is-open')
      document.documentElement.classList.remove('is-menu-open')

      this.panel.setAttribute('aria-hidden', 'true')
      this.panel.setAttribute('inert', '')

      this.toggle.setAttribute('aria-expanded', 'false')
      this.toggle.setAttribute('aria-label', 'Open menu')

      window.lenis?.start?.()

      if (restoreFocus) {
        ;(this.lastFocused ?? this.toggle).focus()
        this.lastFocused = null
      }
    }

    /**
     * Link click handler
     */
    onLinkClick(e: MouseEvent) {
      e.preventDefault()

      const id = (e.currentTarget as HTMLAnchorElement).getAttribute('href')

      // Release the scroll lock before scrolling, then match the header's easing.
      this.close(false)

      window.lenis?.scrollTo(id, {
        duration: 1.5,
        easing: (t: number) =>
          t < 0.5 ? 16 * t * t * t * t * t : 1 + 16 * --t * t * t * t * t,
      })
    }

    /**
     * Key handler — Escape closes, Tab stays inside the panel
     */
    onKeyDown(e: KeyboardEvent) {
      if (!this.isOpen) return

      if (e.key === 'Escape') {
        e.preventDefault()
        this.close()

        return
      }

      if (e.key !== 'Tab') return

      const items = Array.from(
        this.panel.querySelectorAll<HTMLElement>(FOCUSABLE)
      )

      if (!items.length) return

      const first = items[0]
      const last = items[items.length - 1]
      const active = document.activeElement

      // The toggle sits outside the panel, so include it as the final stop.
      if (e.shiftKey && (active === first || active === this.toggle)) {
        e.preventDefault()
        last.focus()
      } else if (!e.shiftKey && active === last) {
        e.preventDefault()
        this.toggle.focus()
      } else if (!e.shiftKey && active === this.toggle) {
        e.preventDefault()
        first.focus()
      }
    }
  }

  new Menu()
</script>

<style lang="scss">
  /* Freeze the page behind the panel without losing the scroll offset. */
  :global(html.is-menu-open),
  :global(html.is-menu-open body) {
    overflow: hidden;
    touch-action: none;
  }

  .site-menu {
    display: none;

    @include mq(tablet) {
      display: block;
    }

    &__toggle {
      @include flex(row, center, center);

      position: fixed;
      right: 2rem;
      bottom: 2rem;
      z-index: 31;

      width: 3.5rem;
      height: 3.5rem;

      appearance: none;
      background: color(secondary);
      border: 0;
      border-radius: 50%;
      cursor: pointer;

      transition: scale var(--hover-duration) var(--hover-ease);

      @include mq(phone) {
        right: 1.25rem;
        bottom: 1.25rem;
      }

      &:active {
        scale: 0.92;

        transition-duration: var(--press-duration);
      }

      &:focus-visible {
        outline: 2px solid color(secondary);
        outline-offset: 3px;
      }
    }

    &__bars {
      position: relative;

      display: block;
      width: 1.125rem;
      height: 0.5rem;
    }

    &__bar {
      position: absolute;
      left: 0;

      display: block;
      width: 100%;
      height: 1px;

      background: color(primary);

      transition: transform 0.4s ease(in-out-expo);

      &:first-child {
        top: 0;
      }

      &:last-child {
        bottom: 0;
      }
    }

    &.is-open {
      .site-menu__bar {
        &:first-child {
          transform: translate3d(0, 0.25rem, 0) rotate(45deg);
        }

        &:last-child {
          transform: translate3d(0, -0.25rem, 0) rotate(-45deg);
        }
      }
    }

    &__panel {
      @include flex(column, stretch, space-between);

      position: fixed;
      top: 0;
      left: 0;
      z-index: 30;

      width: 100%;
      height: 100lvh;
      padding: 4rem 1.5rem 8rem;

      background: color(primary);
      border: 1rem solid color(secondary);
      clip-path: inset(0 0 100% 0);
      visibility: hidden;

      /*
       * The lock above sets `touch-action: none` on the body; restore panning
       * here so a short landscape viewport can still reach the footer links.
       */
      overflow-y: auto;
      overscroll-behavior: contain;
      touch-action: pan-y;

      transition:
        clip-path 0.8s ease(in-out-expo),
        visibility 0s linear 0.8s;

      @include mq(phone) {
        padding: 2.5rem 1rem 6rem;

        border-width: 0.5rem;
      }
    }

    &.is-open &__panel {
      clip-path: inset(0 0 0 0);
      visibility: visible;

      transition:
        clip-path 0.8s ease(in-out-expo),
        visibility 0s linear 0s;
    }

    &__list {
      @include flex(column, stretch, center);

      margin: 0;
      padding: 0;

      flex-grow: 1;
      list-style: none;
    }

    &__item {
      margin: 0;
      padding: 0.5rem 0;

      border-bottom: 1px solid color(secondary);

      &:first-child {
        border-top: 1px solid color(secondary);
      }

      a {
        @include flex(row, baseline, flex-start);
        gap: 1rem;

        color: color(secondary);
        text-decoration: none;

        /* Each row rises in behind the panel wipe. */
        opacity: 0;
        transform: translate3d(0, 1.25rem, 0);

        transition:
          opacity 0.6s ease(out-expo),
          transform 0.6s ease(out-expo);
      }

      &.is-active {
        .site-menu__index {
          opacity: 1;
        }

        .site-menu__label {
          font-style: italic;
        }
      }
    }

    &.is-open &__item a {
      opacity: 1;
      transform: none;

      /* Stagger keyed off --i, set per item in the markup. */
      transition-delay: calc(0.32s + var(--i) * 0.07s);
    }

    &__index {
      flex-grow: 0;
      flex-shrink: 0;

      font: 400 11px / 1 font-family(fraktion);
      letter-spacing: 0.1em;
      opacity: 0.55;
    }

    &__label {
      display: block;

      font: 700 clamp(2.75rem, 13vw, 5.5rem) / 0.9 font-family(bigger);
      text-transform: uppercase;
    }

    &__foot {
      @include flex(column, flex-start, flex-end);
      gap: 1rem;

      flex-grow: 0;
      flex-shrink: 0;

      opacity: 0;
      transform: translate3d(0, 1.25rem, 0);

      transition:
        opacity 0.6s ease(out-expo),
        transform 0.6s ease(out-expo);
    }

    &.is-open &__foot {
      opacity: 1;
      transform: none;

      transition-delay: calc(0.32s + var(--i) * 0.07s);
    }

    &__cta {
      /* Shape and interaction come from the shared .c-btn in site/_button.scss. */
      flex-grow: 0;
      flex-shrink: 0;
    }

    &__mail {
      color: color(secondary);
      font: 400 13px / 1 font-family(fraktion);
      letter-spacing: 0.05em;
      text-decoration: none;

      border-bottom: 1px solid currentcolor;
    }
  }
</style>
