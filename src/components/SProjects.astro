  @media (prefers-reduced-motion: reduce) {
    .s-projects.is-cluster-js .s__slots {
      translate: 0 var(--lift, 0px);
      rotate: none;

      transition: none;
    }

    .s-projects.is-cluster-js .s__slot {
      /* Settled, placed, and completely still. */
      --settle: 1;

      translate: none;
      rotate: none;
      animation: none;

      transition: none;
    }
  }
